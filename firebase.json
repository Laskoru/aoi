{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "aoi-koi",
          "appId": "1:144445288274:android:dd37fa1e95404695f2d48b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "aoi-koi",
          "configurations": {
            "android": "1:144445288274:android:dd37fa1e95404695f2d48b",
            "ios": "1:144445288274:ios:2576a0deedff0712f2d48b",
            "macos": "1:144445288274:ios:2576a0deedff0712f2d48b",
            "web": "1:144445288274:web:d91e9de8be3256b5f2d48b",
            "windows": "1:144445288274:web:0c54e25b625d6d79f2d48b"
          }
        }
      }
    }
  }
}
