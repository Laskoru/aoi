rules_version = '2';

// Règles de sécurité Firestore — AOI KOI
//
// Principe : chaque document porte un champ `userId`. Un utilisateur ne peut
// lire et écrire que ses propres documents. Rien n'est accessible sans
// authentification.
//
// Déploiement : firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions utilitaires ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Le document existant appartient à l'utilisateur connecté.
    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Le document entrant est bien estampillé au nom de l'utilisateur connecté.
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Le propriétaire d'un document ne doit jamais pouvoir changer.
    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    // --- Collection des koï ---

    match /kois/{koiId} {
      // Contrôles applicables à toute écriture. Chaque champ n'est vérifié que
      // s'il est présent : une fiche ancienne à qui il manque `variety` doit
      // rester modifiable, sans quoi on ne pourrait plus la compléter.
      function wellFormedKoi() {
        let d = request.resource.data;
        return (!('name' in d) || (d.name is string && d.name.size() <= 80))
            && (!('variety' in d) || (d.variety is string && d.variety.size() <= 80))
            && (!('size' in d) || (d.size is number && d.size >= 0 && d.size <= 200))
            // birthDate est le nouveau champ, age l'ancien : les deux sont
            // tolérés le temps de la migration.
            && (!('birthDate' in d) || d.birthDate == null || d.birthDate is timestamp)
            && (!('age' in d) || d.age == null || d.age is number)
            && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 2000))
            && (!('pondId' in d) || d.pondId == null || d.pondId is string);
      }

      // À la création, on exige en plus le minimum vital.
      function completeKoi() {
        let d = request.resource.data;
        return wellFormedKoi()
            && d.name is string
            && d.name.size() > 0
            && d.size is number;
      }

      allow read:   if ownsExisting();
      allow create: if ownsIncoming() && completeKoi();
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && wellFormedKoi();
      allow delete: if ownsExisting();

      // Historique des mesures de taille. La propriété se déduit du koï parent :
      // les documents de croissance n'ont pas besoin de porter userId.
      match /growth/{growthId} {
        function parentKoi() {
          return get(/databases/$(database)/documents/kois/$(koiId)).data;
        }

        function ownsParentKoi() {
          return isSignedIn()
              && exists(/databases/$(database)/documents/kois/$(koiId))
              && parentKoi().userId == request.auth.uid;
        }

        allow read:   if ownsParentKoi();
        allow create: if ownsParentKoi()
                      && request.resource.data.size is number
                      && request.resource.data.size >= 0
                      && request.resource.data.size <= 200;
        allow update, delete: if ownsParentKoi();
      }

      // Galerie de photos, même principe : la propriété se déduit du koï.
      match /photos/{photoId} {
        function ownsParentKoi() {
          return isSignedIn()
              && exists(/databases/$(database)/documents/kois/$(koiId))
              && get(/databases/$(database)/documents/kois/$(koiId)).data.userId == request.auth.uid;
        }

        // url est une référence photo:{id} ; storagePath n'existe que sur les
        // photos d'avant le passage à Firestore.
        allow read:   if ownsParentKoi();
        allow create: if ownsParentKoi()
                      && request.resource.data.url is string
                      && (!('storagePath' in request.resource.data)
                          || request.resource.data.storagePath is string);
        allow update, delete: if ownsParentKoi();
      }
    }

    // --- Bassins ---
    //
    // Un seul par utilisateur aujourd'hui, à l'identifiant déterministe
    // default_{uid}. Les autres collections y renvoient par un pondId
    // optionnel : absent, c'est le bassin par défaut.

    match /ponds/{pondId} {
      function wellFormedPond() {
        let d = request.resource.data;
        return (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 80))
            && (!('volumeLiters' in d) || d.volumeLiters == null || (d.volumeLiters is number && d.volumeLiters >= 0))
            && (!('depthCm' in d) || d.depthCm == null || (d.depthCm is number && d.depthCm >= 0))
            && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 2000));
      }

      // Lire un bassin absent est permis : on n'y apprend rien, et l'appli
      // doit pouvoir constater que le bassin par défaut n'existe pas encore
      // avant de le créer. Sans cela, le flux du bassin échoue au lieu de
      // renvoyer « pas encore créé ».
      allow read:   if isSignedIn()
                    && (resource == null || resource.data.userId == request.auth.uid);
      // Le bassin par défaut porte l'identifiant de son propriétaire :
      // personne d'autre ne peut le créer à sa place.
      allow create: if ownsIncoming() && wellFormedPond()
                    && (!pondId.matches('default_.*') || pondId == 'default_' + request.auth.uid);
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && wellFormedPond();
      allow delete: if ownsExisting();
    }

    // --- Photos ---
    //
    // Les images elles-mêmes, en JPEG : Cloud Storage exige la formule Blaze
    // depuis février 2026, Firestore reste gratuit jusqu'à 1 Gio. Les fiches
    // y renvoient par une référence photo:{id}. Une photo ne change jamais :
    // on en enregistre une nouvelle et on supprime l'ancienne.

    match /photos/{photoId} {
      allow read:   if ownsExisting();
      allow create: if ownsIncoming()
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() <= 900 * 1024;
      allow update: if false;
      allow delete: if ownsExisting();
    }

    // --- Plantes ---

    match /plants/{plantId} {
      function wellFormedPlant() {
        let d = request.resource.data;
        return (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 80))
            && (!('species' in d) || d.species == null || (d.species is string && d.species.size() <= 120))
            && (!('zone' in d) || d.zone in ['berge', 'marecage', 'immergee', 'profonde'])
            && (!('quantity' in d) || (d.quantity is int && d.quantity >= 0 && d.quantity <= 10000))
            && (!('isFloating' in d) || d.isFloating is bool)
            && (!('isOxygenating' in d) || d.isOxygenating is bool)
            && (!('plantedAt' in d) || d.plantedAt == null || d.plantedAt is timestamp)
            && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 2000))
            && (!('pondId' in d) || d.pondId == null || d.pondId is string);
      }

      allow read:   if ownsExisting();
      allow create: if ownsIncoming() && wellFormedPlant() && request.resource.data.name is string;
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && wellFormedPlant();
      allow delete: if ownsExisting();
    }

    // --- Groupes de poissons autres que les koï ---

    match /fish_groups/{groupId} {
      function wellFormedGroup() {
        let d = request.resource.data;
        return (!('species' in d) || (d.species is string && d.species.size() > 0 && d.species.size() <= 80))
            && (!('count' in d) || (d.count is int && d.count >= 0 && d.count <= 100000))
            && (!('introducedAt' in d) || d.introducedAt == null || d.introducedAt is timestamp)
            && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 2000))
            && (!('pondId' in d) || d.pondId == null || d.pondId is string);
      }

      allow read:   if ownsExisting();
      allow create: if ownsIncoming() && wellFormedGroup() && request.resource.data.species is string;
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && wellFormedGroup();
      allow delete: if ownsExisting();
    }

    // --- Mesures de l'eau du bassin ---

    match /measurements/{measurementId} {
      function validMeasurement() {
        let d = request.resource.data;
        return d.ph is number
            && d.ph >= 0
            && d.ph <= 14
            && d.temperature is number
            && d.temperature >= -10
            && d.temperature <= 60
            && (!('pondId' in d) || d.pondId == null || d.pondId is string);
      }

      allow read:   if ownsExisting();
      allow create: if ownsIncoming() && validMeasurement();
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && validMeasurement();
      allow delete: if ownsExisting();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
