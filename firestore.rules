rules_version = '2';

// Règles de sécurité Firestore — AOI KOI
//
// Principe : chaque document porte un champ `userId`. Un utilisateur ne peut
// lire et écrire que ses propres documents. Rien n'est accessible sans
// authentification.
//
// Déploiement : firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions utilitaires ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Le document existant appartient à l'utilisateur connecté.
    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Le document entrant est bien estampillé au nom de l'utilisateur connecté.
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Le propriétaire d'un document ne doit jamais pouvoir changer.
    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    // --- Collection des koï ---

    match /kois/{koiId} {
      // Contrôles applicables à toute écriture. Chaque champ n'est vérifié que
      // s'il est présent : une fiche ancienne à qui il manque `variety` doit
      // rester modifiable, sans quoi on ne pourrait plus la compléter.
      function wellFormedKoi() {
        let d = request.resource.data;
        return (!('name' in d) || (d.name is string && d.name.size() <= 80))
            && (!('variety' in d) || (d.variety is string && d.variety.size() <= 80))
            && (!('size' in d) || (d.size is number && d.size >= 0 && d.size <= 200))
            // birthDate est le nouveau champ, age l'ancien : les deux sont
            // tolérés le temps de la migration.
            && (!('birthDate' in d) || d.birthDate == null || d.birthDate is timestamp)
            && (!('age' in d) || d.age == null || d.age is number)
            && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 2000));
      }

      // À la création, on exige en plus le minimum vital.
      function completeKoi() {
        let d = request.resource.data;
        return wellFormedKoi()
            && d.name is string
            && d.name.size() > 0
            && d.size is number;
      }

      allow read:   if ownsExisting();
      allow create: if ownsIncoming() && completeKoi();
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && wellFormedKoi();
      allow delete: if ownsExisting();

      // Historique des mesures de taille. La propriété se déduit du koï parent :
      // les documents de croissance n'ont pas besoin de porter userId.
      match /growth/{growthId} {
        function parentKoi() {
          return get(/databases/$(database)/documents/kois/$(koiId)).data;
        }

        function ownsParentKoi() {
          return isSignedIn()
              && exists(/databases/$(database)/documents/kois/$(koiId))
              && parentKoi().userId == request.auth.uid;
        }

        allow read:   if ownsParentKoi();
        allow create: if ownsParentKoi()
                      && request.resource.data.size is number
                      && request.resource.data.size >= 0
                      && request.resource.data.size <= 200;
        allow update, delete: if ownsParentKoi();
      }
    }

    // --- Mesures de l'eau du bassin ---

    match /measurements/{measurementId} {
      function validMeasurement() {
        let d = request.resource.data;
        return d.ph is number
            && d.ph >= 0
            && d.ph <= 14
            && d.temperature is number
            && d.temperature >= -10
            && d.temperature <= 60;
      }

      allow read:   if ownsExisting();
      allow create: if ownsIncoming() && validMeasurement();
      allow update: if ownsExisting() && ownsIncoming() && ownerUnchanged() && validMeasurement();
      allow delete: if ownsExisting();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
