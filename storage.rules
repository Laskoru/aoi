rules_version = '2';

// Règles de sécurité Cloud Storage — AOI KOI
//
// L'appli n'écrit plus dans Cloud Storage : depuis février 2026, il exige la
// formule Blaze, et les photos sont rangées dans Firestore (collection
// `photos`). Restent les photos d'avant, sous
//   kois_photos/{userId}/…  et  user_media/{userId}/…
// que leur propriétaire peut encore lire et supprimer. Toute écriture est
// refusée : passer un jour à Blaze n'ouvrirait pas de stockage facturable à
// n'importe quel compte connecté.
//
// Déploiement : firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /kois_photos/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
    }

    match /user_media/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
    }

    // Tout le reste, et toute écriture, est refusé.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
